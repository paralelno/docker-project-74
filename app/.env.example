# Диалект базы. По умолчанию sqlite: приложение запускается без внешней базы.
# Для деплоя используется postgres.
DATABASE_CLIENT=postgres

# Подключение по частям (host = сервис db в docker-compose.yml).
# Не задавайте DATABASE_URL целиком — приложение отдаёт ему приоритет над частями.
DATABASE_NAME=postgres
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=***
DATABASE_PORT=5432
DATABASE_HOST=db
